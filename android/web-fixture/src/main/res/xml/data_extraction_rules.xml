<?xml version="1.0" encoding="utf-8"?>
<!-- 配置用途：禁止 fixture 状态和缓存进入云备份或设备迁移，防止测试数据跨轮次泄漏。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
