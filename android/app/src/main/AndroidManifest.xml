<?xml version="1.0" encoding="utf-8"?>
<!-- 配置用途：声明主 App 的网络、用户触发相机扫码、入口 Activity 与生产无障碍服务。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 前台服务：AI 自动化会话运行时保活，用户可通过通知随时暂停/停止。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知：Android 13+ 运行时权限，用于显示会话运行状态通知。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 麦克风：按需语音输入，权限拒绝后降级为文本输入。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 悬浮窗：受控悬浮助理，需用户在系统设置中手动授权。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 配置用途：无相机设备仍可安装并使用手工邀请码。 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".AiAutoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiAutoAndroid"
        android:usesCleartextTraffic="false">
        <!-- 配置用途：唯一主入口复用原 Activity/NavHost，并通过 onNewIntent 接收 Launcher 或显式启动。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".accessibility.AiAutomationAccessibilityService"
            android:description="@string/accessibility_service_description"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- AI 自动化会话前台服务：runtime owner，锁屏时强制暂停，通知可暂停/停止。 -->
        <service
            android:name=".automation.session.service.AutomationSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="AI automation session runtime with user-visible pause/stop controls" />
        </service>
    </application>
</manifest>
