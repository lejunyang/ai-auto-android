{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-android.dev/protocol/v1/recording-list-result.schema.json",
  "title": "Sanitized Recording List Result",
  "type": "object",
  "required": ["recordings"],
  "properties": {
    "recordings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/summary"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "summary": {
      "type": "object",
      "required": [
        "id",
        "name",
        "targetPackages",
        "stepCount",
        "createdAt",
        "requirements"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetPackages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/packageName"
          }
        },
        "stepCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "requirements": {
          "type": "object",
          "required": ["minApiLevel", "capabilities"],
          "properties": {
            "minApiLevel": {
              "type": "integer",
              "minimum": 30,
              "maximum": 1000
            },
            "capabilities": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
