{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-android.dev/protocol/v1/automation-script.schema.json",
  "title": "Recorded Automation Script",
  "type": "object",
  "required": ["id", "schemaVersion", "name", "targetPackages", "createdAt", "requirements", "steps"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "targetPackages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/packageName"
      }
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "requirements": {
      "type": "object",
      "required": ["minApiLevel", "capabilities"],
      "properties": {
        "minApiLevel": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1000
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "apiLevel": {
          "type": "integer",
          "minimum": 1
        },
        "logicalWidth": {
          "type": "integer",
          "minimum": 1
        },
        "logicalHeight": {
          "type": "integer",
          "minimum": 1
        },
        "densityDpi": {
          "type": "integer",
          "minimum": 1
        },
        "rotation": {
          "enum": [0, 90, 180, 270]
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        }
      },
      "additionalProperties": true
    },
    "variables": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "variable": {
      "type": "object",
      "required": ["name", "type", "scope", "sensitive"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "type": {
          "enum": ["string", "integer", "boolean", "json", "secret"]
        },
        "scope": {
          "enum": ["script", "run", "step"]
        },
        "sensitive": {
          "type": "boolean"
        },
        "default": true
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "required": ["maxAttempts", "backoffMs"],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "backoffMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "action", "retry", "failurePolicy"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "recordedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "$ref": "action.schema.json"
        },
        "waitAfter": {
          "$ref": "action.schema.json#/$defs/predicate"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "failurePolicy": {
          "enum": ["stop", "requestIntervention"]
        }
      },
      "additionalProperties": true
    }
  }
}
