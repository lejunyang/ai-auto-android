{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-android.dev/protocol/v1/automation-script-v1.1.schema.json",
  "title": "Automation Script 1.1",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "revision",
    "name",
    "targetPackages",
    "createdAt",
    "updatedAt",
    "provenance",
    "requirements",
    "steps"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "schemaVersion": {
      "const": "1.1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "targetPackages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/packageName"
      }
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "variables": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "enum": [
        "semantic",
        "visual",
        "coordinate",
        "manual",
        "imported"
      ]
    },
    "requirements": {
      "type": "object",
      "required": [
        "minApiLevel",
        "capabilities"
      ],
      "properties": {
        "minApiLevel": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1000
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "apiLevel": {
          "type": "integer",
          "minimum": 1
        },
        "logicalWidth": {
          "type": "integer",
          "minimum": 1
        },
        "logicalHeight": {
          "type": "integer",
          "minimum": 1
        },
        "densityDpi": {
          "type": "integer",
          "minimum": 1
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "fontScale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": [
        "name",
        "type",
        "scope",
        "sensitive"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "json",
            "secret"
          ]
        },
        "scope": {
          "enum": [
            "script",
            "run",
            "step"
          ]
        },
        "sensitive": {
          "type": "boolean"
        },
        "default": true
      },
      "additionalProperties": false
    },
    "normalizedBounds": {
      "type": "object",
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "visualTarget": {
      "type": "object",
      "required": [
        "confidence",
        "source"
      ],
      "properties": {
        "normalizedPoint": {
          "$ref": "common.schema.json#/$defs/normalizedPoint"
        },
        "normalizedBounds": {
          "$ref": "#/$defs/normalizedBounds"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/provenance"
        },
        "observationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "imageSha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "screenshotBase64": {
          "type": "string",
          "maxLength": 16777216,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "deviceLocalPath": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^/(?:data|storage|sdcard|mnt|system|vendor)/"
        }
      },
      "anyOf": [
        {
          "required": [
            "normalizedPoint"
          ]
        },
        {
          "required": [
            "normalizedBounds"
          ]
        }
      ],
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "required": [
        "maxAttempts",
        "backoffMs"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "backoffMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "backoffMultiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "maxBackoffMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "provenance",
        "enabled",
        "action",
        "retry",
        "failurePolicy"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "recordedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "enabled": {
          "type": "boolean"
        },
        "action": {
          "$ref": "action.schema.json"
        },
        "visualTarget": {
          "$ref": "#/$defs/visualTarget"
        },
        "notes": {
          "type": "string",
          "maxLength": 4096
        },
        "waitBefore": {
          "$ref": "action.schema.json#/$defs/predicate"
        },
        "waitAfter": {
          "$ref": "action.schema.json#/$defs/predicate"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "failurePolicy": {
          "enum": [
            "stop",
            "requestIntervention"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
