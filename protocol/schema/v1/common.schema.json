{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-android.dev/protocol/v1/common.schema.json",
  "title": "AI Auto Android Protocol Common Types",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "packageName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "coordinate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "normalizedCoordinate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "additionalProperties": false
    },
    "normalizedPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "$ref": "#/$defs/normalizedCoordinate"
        },
        "y": {
          "$ref": "#/$defs/normalizedCoordinate"
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": {
          "$ref": "#/$defs/coordinate"
        },
        "top": {
          "$ref": "#/$defs/coordinate"
        },
        "right": {
          "$ref": "#/$defs/coordinate"
        },
        "bottom": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "additionalProperties": false
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
