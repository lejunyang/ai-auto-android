{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-android.dev/protocol/v1/action.schema.json",
  "title": "Typed Android Automation Action",
  "oneOf": [
    {
      "$ref": "#/$defs/appLaunch"
    },
    {
      "$ref": "#/$defs/appStop"
    },
    {
      "$ref": "#/$defs/uiClick"
    },
    {
      "$ref": "#/$defs/uiLongClick"
    },
    {
      "$ref": "#/$defs/uiTap"
    },
    {
      "$ref": "#/$defs/uiSwipe"
    },
    {
      "$ref": "#/$defs/uiSetText"
    },
    {
      "$ref": "#/$defs/uiScroll"
    },
    {
      "$ref": "#/$defs/uiBack"
    },
    {
      "$ref": "#/$defs/uiHome"
    },
    {
      "$ref": "#/$defs/uiRecents"
    },
    {
      "$ref": "#/$defs/uiWait"
    },
    {
      "$ref": "#/$defs/uiAssert"
    },
    {
      "$ref": "#/$defs/taskFinish"
    }
  ],
  "$defs": {
    "selectorCandidate": {
      "type": "object",
      "required": ["strategy", "value", "weight"],
      "properties": {
        "strategy": {
          "enum": ["resourceId", "contentDescription", "text", "role", "ancestor", "fingerprint"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "packageName": {
          "$ref": "common.schema.json#/$defs/packageName"
        },
        "selectorCandidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/selectorCandidate"
          }
        },
        "fingerprint": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "recordedBounds": {
          "$ref": "common.schema.json#/$defs/bounds"
        },
        "relativePoint": {
          "$ref": "common.schema.json#/$defs/normalizedPoint"
        },
        "normalizedScreenPoint": {
          "$ref": "common.schema.json#/$defs/normalizedPoint"
        }
      },
      "anyOf": [
        {
          "required": ["selectorCandidates"]
        },
        {
          "required": ["recordedBounds", "relativePoint"]
        },
        {
          "required": ["normalizedScreenPoint"]
        }
      ],
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": ["kind", "operator"],
      "properties": {
        "kind": {
          "enum": ["node", "text", "package", "window", "uiStable"]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "operator": {
          "enum": ["exists", "notExists", "equals", "contains", "matches", "stable"]
        },
        "expected": {
          "type": ["string", "number", "integer", "boolean", "null"]
        },
        "stableDurationMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "timeoutMs": {
          "$ref": "common.schema.json#/$defs/deadlineMs"
        }
      },
      "additionalProperties": false
    },
    "emptyParams": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "appLaunch": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "app.launch"
        },
        "params": {
          "type": "object",
          "required": ["packageName"],
          "properties": {
            "packageName": {
              "$ref": "common.schema.json#/$defs/packageName"
            },
            "activity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "appStop": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "app.stop"
        },
        "params": {
          "type": "object",
          "required": ["packageName"],
          "properties": {
            "packageName": {
              "$ref": "common.schema.json#/$defs/packageName"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uiClick": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.click"
        },
        "params": {
          "type": "object",
          "required": ["target"],
          "properties": {
            "target": {
              "$ref": "#/$defs/target"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uiLongClick": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.longClick"
        },
        "params": {
          "type": "object",
          "required": ["target"],
          "properties": {
            "target": {
              "$ref": "#/$defs/target"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 300,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uiTap": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.tap"
        },
        "params": {
          "$ref": "common.schema.json#/$defs/point"
        }
      },
      "additionalProperties": false
    },
    "uiSwipe": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.swipe"
        },
        "params": {
          "type": "object",
          "required": ["start", "end", "durationMs"],
          "properties": {
            "start": {
              "$ref": "common.schema.json#/$defs/point"
            },
            "end": {
              "$ref": "common.schema.json#/$defs/point"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uiSetText": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.setText"
        },
        "params": {
          "type": "object",
          "required": ["target"],
          "properties": {
            "target": {
              "$ref": "#/$defs/target"
            },
            "text": {
              "type": "string",
              "maxLength": 10000
            },
            "secretRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "oneOf": [
            {
              "required": ["text"]
            },
            {
              "required": ["secretRef"]
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uiScroll": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.scroll"
        },
        "params": {
          "type": "object",
          "required": ["direction"],
          "properties": {
            "target": {
              "$ref": "#/$defs/target"
            },
            "direction": {
              "enum": ["up", "down", "left", "right", "forward", "backward"]
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uiBack": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.back"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        }
      },
      "additionalProperties": false
    },
    "uiHome": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.home"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        }
      },
      "additionalProperties": false
    },
    "uiRecents": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.recents"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        }
      },
      "additionalProperties": false
    },
    "uiWait": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.wait"
        },
        "params": {
          "$ref": "#/$defs/predicate"
        }
      },
      "additionalProperties": false
    },
    "uiAssert": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "ui.assert"
        },
        "params": {
          "$ref": "#/$defs/predicate"
        }
      },
      "additionalProperties": false
    },
    "taskFinish": {
      "type": "object",
      "required": ["type", "params"],
      "properties": {
        "type": {
          "const": "task.finish"
        },
        "params": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
