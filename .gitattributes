# 配置用途：固定跨平台 checkout 行尾，避免 Windows 自动转 CRLF 破坏格式与脚本语义。
* text=auto

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
Makefile text eol=lf
android/gradlew text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jar binary
*.zip binary
*.apk binary
