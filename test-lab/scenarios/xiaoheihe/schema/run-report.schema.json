{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiauto.dev/schema/test-lab/scenarios/xiaoheihe/run-report-v1.json",
  "title": "N50 Xiaoheihe Safe Compatibility Run Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "scenarioId",
    "manifestBinding",
    "matrix",
    "runs",
    "statistics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "reportId": {
      "$ref": "#/$defs/identifier"
    },
    "scenarioId": {
      "const": "n50-xiaoheihe-public-browse-v1"
    },
    "manifestBinding": {
      "$ref": "#/$defs/manifestBinding"
    },
    "matrix": {
      "$ref": "#/$defs/matrix"
    },
    "runs": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,126}[a-z0-9])$"
    },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestFile",
        "packageName",
        "versionName",
        "versionCode",
        "abi",
        "apkSha256",
        "signingCertificateSha256"
      ],
      "properties": {
        "manifestFile": {
          "const": "xiaoheihe-1.3.392-arm64.json"
        },
        "packageName": {
          "const": "com.max.xiaoheihe"
        },
        "versionName": {
          "const": "1.3.392"
        },
        "versionCode": {
          "const": 1114
        },
        "abi": {
          "const": "arm64-v8a"
        },
        "apkSha256": {
          "const": "ee56e4220c98f160f5b744cb90aab8de87787801c45fa5bcb9cb1b531067b0ea"
        },
        "signingCertificateSha256": {
          "const": "ef42d004ab18b04e0789a9c2a246156589423f9186a345a5b0c52fcb6612d82c"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportedApiLevels",
        "requiredRuns"
      ],
      "properties": {
        "supportedApiLevels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              30,
              33,
              34
            ]
          }
        },
        "requiredRuns": {
          "const": 10
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "manifestFile",
        "packageName",
        "versionName",
        "versionCode",
        "abi",
        "apkSha256",
        "signingCertificateSha256",
        "apiLevel",
        "iteration"
      ],
      "properties": {
        "scenarioId": {
          "const": "n50-xiaoheihe-public-browse-v1"
        },
        "manifestFile": {
          "const": "xiaoheihe-1.3.392-arm64.json"
        },
        "packageName": {
          "const": "com.max.xiaoheihe"
        },
        "versionName": {
          "const": "1.3.392"
        },
        "versionCode": {
          "const": 1114
        },
        "abi": {
          "const": "arm64-v8a"
        },
        "apkSha256": {
          "const": "ee56e4220c98f160f5b744cb90aab8de87787801c45fa5bcb9cb1b531067b0ea"
        },
        "signingCertificateSha256": {
          "const": "ef42d004ab18b04e0789a9c2a246156589423f9186a345a5b0c52fcb6612d82c"
        },
        "apiLevel": {
          "enum": [
            30,
            33,
            34
          ]
        },
        "iteration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "sequence",
        "foreground",
        "surface",
        "consent",
        "permission",
        "dynamicContent",
        "advertisement",
        "network"
      ],
      "properties": {
        "observationId": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "foreground": {
          "enum": [
            "xiaoheihe",
            "system-ui",
            "fixture-peer",
            "unknown"
          ]
        },
        "surface": {
          "enum": [
            "native",
            "webview",
            "system",
            "unknown"
          ]
        },
        "consent": {
          "enum": [
            "clear",
            "blocked"
          ]
        },
        "permission": {
          "enum": [
            "clear",
            "blocked"
          ]
        },
        "dynamicContent": {
          "enum": [
            "stable",
            "changed",
            "unknown"
          ]
        },
        "advertisement": {
          "enum": [
            "absent",
            "present",
            "unknown"
          ]
        },
        "network": {
          "enum": [
            "available",
            "failure",
            "unknown"
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "stepId",
        "action",
        "status",
        "route",
        "attempts",
        "retryCount",
        "actionCommits",
        "preObservationId",
        "postObservationId",
        "errorCode"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "stepId": {
          "$ref": "#/$defs/stepName"
        },
        "action": {
          "$ref": "#/$defs/stepName"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "route": {
          "enum": [
            "native-accessibility",
            "webview-accessibility",
            "system-navigation"
          ]
        },
        "attempts": {
          "const": 1
        },
        "retryCount": {
          "const": 0
        },
        "actionCommits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "preObservationId": {
          "$ref": "#/$defs/identifier"
        },
        "postObservationId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,126}[a-z0-9])$"
        },
        "errorCode": {
          "enum": [
            null,
            "ACTION_COMMIT_UNKNOWN",
            "STEP_FAILED"
          ]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searchHistory",
        "appData",
        "bridge",
        "session",
        "artifacts",
        "snapshot"
      ],
      "properties": {
        "searchHistory": {
          "enum": [
            "cleared",
            "failed"
          ]
        },
        "appData": {
          "enum": [
            "cleared",
            "failed"
          ]
        },
        "bridge": {
          "enum": [
            "cleared",
            "failed"
          ]
        },
        "session": {
          "enum": [
            "cleared",
            "failed"
          ]
        },
        "artifacts": {
          "enum": [
            "cleared",
            "failed"
          ]
        },
        "snapshot": {
          "enum": [
            "restored",
            "failed"
          ]
        }
      }
    },
    "routeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeAccessibilitySteps",
        "webviewAccessibilitySteps",
        "systemNavigationSteps"
      ],
      "properties": {
        "nativeAccessibilitySteps": {
          "$ref": "#/$defs/count"
        },
        "webviewAccessibilitySteps": {
          "$ref": "#/$defs/count"
        },
        "systemNavigationSteps": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "reasonCodes",
        "actionCommits",
        "executedSteps",
        "completedSteps",
        "routeCounts"
      ],
      "properties": {
        "compatible": {
          "type": "boolean"
        },
        "reasonCodes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/reasonCode"
          }
        },
        "actionCommits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 11
        },
        "executedSteps": {
          "$ref": "#/$defs/stepCount"
        },
        "completedSteps": {
          "$ref": "#/$defs/stepCount"
        },
        "routeCounts": {
          "$ref": "#/$defs/routeCounts"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "source",
        "fixtureSource",
        "binding",
        "observations",
        "steps",
        "cleanup",
        "decision"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "enum": [
            "real",
            "fixture"
          ]
        },
        "fixtureSource": {
          "enum": [
            null,
            "N50_OFFLINE_CONTRACT"
          ]
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      }
    },
    "apiCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalRuns",
        "fixtureRuns",
        "realRuns",
        "compatibleRuns",
        "incompatibleRuns",
        "consentBlockedRuns",
        "permissionBlockedRuns"
      ],
      "properties": {
        "totalRuns": {
          "$ref": "#/$defs/runCount"
        },
        "fixtureRuns": {
          "$ref": "#/$defs/runCount"
        },
        "realRuns": {
          "$ref": "#/$defs/runCount"
        },
        "compatibleRuns": {
          "$ref": "#/$defs/runCount"
        },
        "incompatibleRuns": {
          "$ref": "#/$defs/runCount"
        },
        "consentBlockedRuns": {
          "$ref": "#/$defs/runCount"
        },
        "permissionBlockedRuns": {
          "$ref": "#/$defs/runCount"
        }
      }
    },
    "apiMatrixCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api30",
        "api33",
        "api34"
      ],
      "properties": {
        "api30": {
          "$ref": "#/$defs/apiCounts"
        },
        "api33": {
          "$ref": "#/$defs/apiCounts"
        },
        "api34": {
          "$ref": "#/$defs/apiCounts"
        }
      }
    },
    "actionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public-search-input",
        "public-search-submit",
        "public-detail-open",
        "long-press-safe-content",
        "public-list-scroll",
        "public-list-swipe",
        "back",
        "home",
        "recents",
        "switch-to-fixture-peer",
        "cross-app-return"
      ],
      "properties": {
        "public-search-input": {
          "$ref": "#/$defs/count"
        },
        "public-search-submit": {
          "$ref": "#/$defs/count"
        },
        "public-detail-open": {
          "$ref": "#/$defs/count"
        },
        "long-press-safe-content": {
          "$ref": "#/$defs/count"
        },
        "public-list-scroll": {
          "$ref": "#/$defs/count"
        },
        "public-list-swipe": {
          "$ref": "#/$defs/count"
        },
        "back": {
          "$ref": "#/$defs/count"
        },
        "home": {
          "$ref": "#/$defs/count"
        },
        "recents": {
          "$ref": "#/$defs/count"
        },
        "switch-to-fixture-peer": {
          "$ref": "#/$defs/count"
        },
        "cross-app-return": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "dynamicContentCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable",
        "changed",
        "unknown"
      ],
      "properties": {
        "stable": {
          "$ref": "#/$defs/count"
        },
        "changed": {
          "$ref": "#/$defs/count"
        },
        "unknown": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "advertisementCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absent",
        "present",
        "unknown"
      ],
      "properties": {
        "absent": {
          "$ref": "#/$defs/count"
        },
        "present": {
          "$ref": "#/$defs/count"
        },
        "unknown": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "networkCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "failure",
        "unknown"
      ],
      "properties": {
        "available": {
          "$ref": "#/$defs/count"
        },
        "failure": {
          "$ref": "#/$defs/count"
        },
        "unknown": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "classificationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dynamicContent",
        "advertisement",
        "network"
      ],
      "properties": {
        "dynamicContent": {
          "$ref": "#/$defs/dynamicContentCounts"
        },
        "advertisement": {
          "$ref": "#/$defs/advertisementCounts"
        },
        "network": {
          "$ref": "#/$defs/networkCounts"
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalRuns",
        "fixtureRuns",
        "realRuns",
        "compatibleRuns",
        "incompatibleRuns",
        "realCompatibleRuns",
        "realIncompatibleRuns",
        "successRate",
        "realSuccessRate",
        "realMatrixComplete",
        "apiCounts",
        "routeCounts",
        "actionCoverage",
        "classificationCounts",
        "consentBlockedRuns",
        "permissionBlockedRuns",
        "unknownCommitRuns",
        "cleanupFailedRuns"
      ],
      "properties": {
        "totalRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "fixtureRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "realRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "compatibleRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "incompatibleRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "realCompatibleRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "realIncompatibleRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "successRate": {
          "$ref": "#/$defs/rate"
        },
        "realSuccessRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "realMatrixComplete": {
          "type": "boolean"
        },
        "apiCounts": {
          "$ref": "#/$defs/apiMatrixCounts"
        },
        "routeCounts": {
          "$ref": "#/$defs/routeCounts"
        },
        "actionCoverage": {
          "$ref": "#/$defs/actionCoverage"
        },
        "classificationCounts": {
          "$ref": "#/$defs/classificationCounts"
        },
        "consentBlockedRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "permissionBlockedRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "unknownCommitRuns": {
          "$ref": "#/$defs/totalRunCount"
        },
        "cleanupFailedRuns": {
          "$ref": "#/$defs/totalRunCount"
        }
      }
    },
    "stepName": {
      "enum": [
        "public-search-input",
        "public-search-submit",
        "public-detail-open",
        "long-press-safe-content",
        "public-list-scroll",
        "public-list-swipe",
        "back",
        "home",
        "recents",
        "switch-to-fixture-peer",
        "cross-app-return"
      ]
    },
    "reasonCode": {
      "enum": [
        "ACTION_COMMIT_UNKNOWN",
        "ADVERTISEMENT_PRESENT",
        "ADVERTISEMENT_UNKNOWN",
        "CLEANUP_FAILED",
        "CONSENT_BLOCKED",
        "DYNAMIC_CONTENT_UNKNOWN",
        "NETWORK_FAILURE",
        "NETWORK_UNKNOWN",
        "OBSERVATION_REFERENCE_INVALID",
        "OBSERVATION_STATE_UNKNOWN",
        "PERMISSION_BLOCKED",
        "POST_OBSERVATION_MISSING",
        "POST_OBSERVATION_MISMATCH",
        "ROUTE_POLICY_MISMATCH",
        "ROUTE_SURFACE_MISMATCH",
        "STEP_FAILED",
        "STEP_SEQUENCE_INCOMPLETE"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "runCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "totalRunCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "stepCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
