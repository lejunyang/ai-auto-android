{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-auto-android.dev/test-lab/artifacts/v1/twenty-run-statistics.schema.json",
  "title": "Deterministic Twenty Run Statistics",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "scenarioId",
    "classification",
    "total",
    "passed",
    "failed",
    "successRate",
    "durationMs",
    "retryCount",
    "failureCounts",
    "errorCodes",
    "flakyIterations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "classification": {
      "enum": [
        "passed",
        "product",
        "device",
        "infrastructure",
        "flaky"
      ]
    },
    "total": {
      "const": 20
    },
    "passed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "successRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "durationMs": {
      "type": "object",
      "required": [
        "min",
        "p50",
        "p95",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "p50": {
          "type": "integer",
          "minimum": 0
        },
        "p95": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "retryCount": {
      "type": "integer",
      "minimum": 0
    },
    "failureCounts": {
      "type": "object",
      "required": [
        "product",
        "device",
        "infrastructure"
      ],
      "properties": {
        "product": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "infrastructure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "errorCodes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "code",
          "count"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "additionalProperties": false
      }
    },
    "flakyIterations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    }
  },
  "additionalProperties": false
}
